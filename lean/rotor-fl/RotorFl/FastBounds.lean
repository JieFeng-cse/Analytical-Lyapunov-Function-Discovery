  have h3 := abs_le.mp (abs_mono_le (1 : ℝ) (1 : ℝ) p₁ (Real.sin r) (Real.cos r) 0 0 1 (by norm_num) (abs_sin_le_one r) (abs_cos_le_one r))
  exact abs_le.mpr ⟨by linarith [h0.1, h0.2, h1.1, h1.2, h2.1, h2.2, h3.1, h3.2], by linarith [h0.1, h0.2, h1.1, h1.2, h2.1, h2.2, h3.1, h3.2]⟩

lemma abs_c4_le (r p₁ : ℝ) : |c4 r p₁| ≤ (13 : ℝ) * |p₁| ^ 0 + (22 : ℝ) * |p₁| ^ 1 + (19 : ℝ) * |p₁| ^ 2 + (6 : ℝ) * |p₁| ^ 3 + (1 : ℝ) * |p₁| ^ 4 := by
  unfold c4
  have h0 := abs_le.mp (abs_mono_le (-(6 : ℝ)) (6 : ℝ) p₁ (Real.sin r) (Real.cos r) 0 1 0 (by norm_num) (abs_sin_le_one r) (abs_cos_le_one r))
  have h1 := abs_le.mp (abs_mono_le (1 : ℝ) (1 : ℝ) p₁ (Real.sin r) (Real.cos r) 0 1 1 (by norm_num) (abs_sin_le_one r) (abs_cos_le_one r))
  have h2 := abs_le.mp (abs_mono_le (-(1 : ℝ)) (1 : ℝ) p₁ (Real.sin r) (Real.cos r) 4 1 0 (by norm_num) (abs_sin_le_one r) (abs_cos_le_one r))
  have h3 := abs_le.mp (abs_mono_le (-(9 : ℝ)) (9 : ℝ) p₁ (Real.sin r) (Real.cos r) 1 0 1 (by norm_num) (abs_sin_le_one r) (abs_cos_le_one r))
  have h4 := abs_le.mp (abs_mono_le (-(6 : ℝ)) (6 : ℝ) p₁ (Real.sin r) (Real.cos r) 0 1 2 (by norm_num) (abs_sin_le_one r) (abs_cos_le_one r))
  have h5 := abs_le.mp (abs_mono_le (6 : ℝ) (6 : ℝ) p₁ (Real.sin r) (Real.cos r) 3 0 1 (by norm_num) (abs_sin_le_one r) (abs_cos_le_one r))
  have h6 := abs_le.mp (abs_mono_le (7 : ℝ) (7 : ℝ) p₁ (Real.sin r) (Real.cos r) 2 1 0 (by norm_num) (abs_sin_le_one r) (abs_cos_le_one r))
  have h7 := abs_le.mp (abs_mono_le (-((19 : ℝ) / (2 : ℝ))) ((19 : ℝ) / (2 : ℝ)) p₁ (Real.sin r) (Real.cos r) 1 2 0 (by norm_num) (abs_sin_le_one r) (abs_cos_le_one r))
  have h8 := abs_le.mp (abs_mono_le ((7 : ℝ) / (2 : ℝ)) ((7 : ℝ) / (2 : ℝ)) p₁ (Real.sin r) (Real.cos r) 1 0 2 (by norm_num) (abs_sin_le_one r) (abs_cos_le_one r))
  have h9 := abs_le.mp (abs_mono_le (-(12 : ℝ)) (12 : ℝ) p₁ (Real.sin r) (Real.cos r) 2 1 1 (by norm_num) (abs_sin_le_one r) (abs_cos_le_one r))
  exact abs_le.mpr ⟨by linarith [h0.1, h0.2, h1.1, h1.2, h2.1, h2.2, h3.1, h3.2, h4.1, h4.2, h5.1, h5.2, h6.1, h6.2, h7.1, h7.2, h8.1, h8.2, h9.1, h9.2], by linarith [h0.1, h0.2, h1.1, h1.2, h2.1, h2.2, h3.1, h3.2, h4.1, h4.2, h5.1, h5.2, h6.1, h6.2, h7.1, h7.2, h8.1, h8.2, h9.1, h9.2]⟩

