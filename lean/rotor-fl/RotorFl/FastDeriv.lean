import RotorFl.FastDefs

namespace RotorFl

open Real

/-- Close `HasDerivAt (fun t => E t) E' t₀` from a combinator-chain proof whose
function/value differ from the goal only by Pi-instance unfolding, casts and
ring normalisation. -/
macro "deriv_tac" h:term : tactic => `(tactic|
  (refine (($h).congr_of_eventuallyEq (Filter.Eventually.of_forall fun x => ?_)).congr_deriv ?_ <;>
    (try simp only [Pi.mul_apply, Pi.add_apply, Pi.pow_apply, Pi.sub_apply, Pi.neg_apply]) <;>
    (try norm_num only) <;> ring))

lemma hasDerivAt_t1_r (r p₁ : ℝ) : HasDerivAt (fun t => t₁ t p₁) (t1_r r p₁) r := by
  unfold t₁ t1_r
  deriv_tac ((hasDerivAt_id' r).cos)

lemma hasDerivAt_t1_p₁ (r p₁ : ℝ) : HasDerivAt (fun t => t₁ r t) (t1_p₁ r p₁) p₁ := by
  unfold t₁ t1_p₁
  deriv_tac (hasDerivAt_const p₁ (Real.cos r))

lemma hasDerivAt_t1_p₁p₁ (r p₁ : ℝ) : HasDerivAt (fun t => t1_p₁ r t) (t1_p₁p₁ r p₁) p₁ := by
  unfold t1_p₁ t1_p₁p₁
  deriv_tac (hasDerivAt_const p₁ (0 : ℝ))

lemma hasDerivAt_t2_r (r p₁ : ℝ) : HasDerivAt (fun t => t₂ t p₁) (t2_r r p₁) r := by
  unfold t₂ t2_r
  deriv_tac ((hasDerivAt_const r p₁).mul ((hasDerivAt_id' r).cos))

lemma hasDerivAt_t2_p₁ (r p₁ : ℝ) : HasDerivAt (fun t => t₂ r t) (t2_p₁ r p₁) p₁ := by
  unfold t₂ t2_p₁
  deriv_tac ((hasDerivAt_id' p₁).mul (hasDerivAt_const p₁ (Real.cos r)))

lemma hasDerivAt_t2_p₁p₁ (r p₁ : ℝ) : HasDerivAt (fun t => t2_p₁ r t) (t2_p₁p₁ r p₁) p₁ := by
  unfold t2_p₁ t2_p₁p₁
  deriv_tac (hasDerivAt_const p₁ (Real.cos r))

lemma hasDerivAt_t3_r (r p₁ : ℝ) : HasDerivAt (fun t => t₃ t p₁) (t3_r r p₁) r := by
  unfold t₃ t3_r
  deriv_tac (((((hasDerivAt_id' r).cos).pow 2).add ((hasDerivAt_const r p₁).mul ((hasDerivAt_id' r).sin))).add ((hasDerivAt_const r (p₁ ^ 2)).mul ((hasDerivAt_id' r).cos)))

lemma hasDerivAt_t3_p₁ (r p₁ : ℝ) : HasDerivAt (fun t => t₃ r t) (t3_p₁ r p₁) p₁ := by
  unfold t₃ t3_p₁
  deriv_tac (((hasDerivAt_const p₁ ((Real.cos r) ^ 2)).add ((hasDerivAt_id' p₁).mul (hasDerivAt_const p₁ (Real.sin r)))).add (((hasDerivAt_id' p₁).pow 2).mul (hasDerivAt_const p₁ (Real.cos r))))

lemma hasDerivAt_t3_p₁p₁ (r p₁ : ℝ) : HasDerivAt (fun t => t3_p₁ r t) (t3_p₁p₁ r p₁) p₁ := by
  unfold t3_p₁ t3_p₁p₁
  deriv_tac ((((hasDerivAt_const p₁ (2 : ℝ)).mul (hasDerivAt_id' p₁)).mul (hasDerivAt_const p₁ (Real.cos r))).add (hasDerivAt_const p₁ (Real.sin r)))

lemma hasDerivAt_t4_r (r p₁ : ℝ) : HasDerivAt (fun t => t₄ t p₁) (t4_r r p₁) r := by
  unfold t₄ t4_r
  deriv_tac (((((((hasDerivAt_const r (2 : ℝ)).mul ((hasDerivAt_id' r).sin)).add ((hasDerivAt_const r p₁).mul ((hasDerivAt_id' r).cos))).add (((hasDerivAt_const r (-(1 : ℝ))).mul (hasDerivAt_const r (p₁ ^ 3))).mul ((hasDerivAt_id' r).cos))).add (((hasDerivAt_const r (-(3 : ℝ))).mul (hasDerivAt_const r p₁)).mul (((hasDerivAt_id' r).cos).pow 2))).add (((hasDerivAt_const r (-(3 : ℝ))).mul (hasDerivAt_const r (p₁ ^ 2))).mul ((hasDerivAt_id' r).sin))).add (((hasDerivAt_const r (-((1 : ℝ) / (2 : ℝ)))).mul ((hasDerivAt_id' r).cos)).mul ((hasDerivAt_id' r).sin)))

lemma hasDerivAt_t4_p₁ (r p₁ : ℝ) : HasDerivAt (fun t => t₄ r t) (t4_p₁ r p₁) p₁ := by
  unfold t₄ t4_p₁
  deriv_tac ((((((hasDerivAt_const p₁ ((2 : ℝ) * (Real.sin r))).add ((hasDerivAt_id' p₁).mul (hasDerivAt_const p₁ (Real.cos r)))).add (((hasDerivAt_const p₁ (-(1 : ℝ))).mul ((hasDerivAt_id' p₁).pow 3)).mul (hasDerivAt_const p₁ (Real.cos r)))).add (((hasDerivAt_const p₁ (-(3 : ℝ))).mul (hasDerivAt_id' p₁)).mul (hasDerivAt_const p₁ ((Real.cos r) ^ 2)))).add (((hasDerivAt_const p₁ (-(3 : ℝ))).mul ((hasDerivAt_id' p₁).pow 2)).mul (hasDerivAt_const p₁ (Real.sin r)))).add (hasDerivAt_const p₁ ((-((1 : ℝ) / (2 : ℝ))) * (Real.cos r) * (Real.sin r))))

lemma hasDerivAt_t4_p₁p₁ (r p₁ : ℝ) : HasDerivAt (fun t => t4_p₁ r t) (t4_p₁p₁ r p₁) p₁ := by
  unfold t4_p₁ t4_p₁p₁
  deriv_tac ((((hasDerivAt_const p₁ ((-(3 : ℝ)) * ((Real.cos r) ^ 2))).add (((hasDerivAt_const p₁ (-(6 : ℝ))).mul (hasDerivAt_id' p₁)).mul (hasDerivAt_const p₁ (Real.sin r)))).add (((hasDerivAt_const p₁ (-(3 : ℝ))).mul ((hasDerivAt_id' p₁).pow 2)).mul (hasDerivAt_const p₁ (Real.cos r)))).add (hasDerivAt_const p₁ (Real.cos r)))

