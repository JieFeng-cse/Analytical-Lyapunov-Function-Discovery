/-
# Fast-region explicit derivatives (GENERATED by utils/fl_lean.py — do not edit)
Derivatives of the counterterms t₁..t₄ and the coefficients of
    L p̃f = c₃ u³ + c₄ u⁴ + c₅ u⁵,   u = 1/p₂   (ρ = 1),  c₃ = −1/2
with explicit polynomial bounds |c₄| ≤ c4_bound |p₁|, |c₅| ≤ c5_bound |p₁|.
-/
import RotorFl.Defs

namespace RotorFl

/-- ∂_r t1 -/
noncomputable def t1_r (r p₁ : ℝ) : ℝ := ((-(1 : ℝ)) * (Real.sin r))

/-- ∂_p₁ t1 -/
noncomputable def t1_p₁ (r p₁ : ℝ) : ℝ := (0 : ℝ)

/-- ∂_p₁p₁ t1 -/
noncomputable def t1_p₁p₁ (r p₁ : ℝ) : ℝ := (0 : ℝ)

/-- ∂_r t2 -/
noncomputable def t2_r (r p₁ : ℝ) : ℝ := ((-(1 : ℝ)) * p₁ * (Real.sin r))

/-- ∂_p₁ t2 -/
noncomputable def t2_p₁ (r p₁ : ℝ) : ℝ := (Real.cos r)

/-- ∂_p₁p₁ t2 -/
noncomputable def t2_p₁p₁ (r p₁ : ℝ) : ℝ := (0 : ℝ)

/-- ∂_r t3 -/
noncomputable def t3_r (r p₁ : ℝ) : ℝ := ((p₁ * (Real.cos r)) + ((-(1 : ℝ)) * (p₁ ^ 2) * (Real.sin r)) + ((-(2 : ℝ)) * (Real.cos r) * (Real.sin r)))

/-- ∂_p₁ t3 -/
noncomputable def t3_p₁ (r p₁ : ℝ) : ℝ := (((2 : ℝ) * p₁ * (Real.cos r)) + (Real.sin r))

/-- ∂_p₁p₁ t3 -/
noncomputable def t3_p₁p₁ (r p₁ : ℝ) : ℝ := ((2 : ℝ) * (Real.cos r))

/-- ∂_r t4 -/
noncomputable def t4_r (r p₁ : ℝ) : ℝ := ((((1 : ℝ) / (2 : ℝ)) * ((Real.sin r) ^ 2)) + ((2 : ℝ) * (Real.cos r)) + ((-((1 : ℝ) / (2 : ℝ))) * ((Real.cos r) ^ 2)) + ((p₁ ^ 3) * (Real.sin r)) + ((-(1 : ℝ)) * p₁ * (Real.sin r)) + ((-(3 : ℝ)) * (p₁ ^ 2) * (Real.cos r)) + ((6 : ℝ) * p₁ * (Real.cos r) * (Real.sin r)))

/-- ∂_p₁ t4 -/
noncomputable def t4_p₁ (r p₁ : ℝ) : ℝ := (((-(3 : ℝ)) * ((Real.cos r) ^ 2)) + ((-(6 : ℝ)) * p₁ * (Real.sin r)) + ((-(3 : ℝ)) * (p₁ ^ 2) * (Real.cos r)) + (Real.cos r))

/-- ∂_p₁p₁ t4 -/
noncomputable def t4_p₁p₁ (r p₁ : ℝ) : ℝ := (((-(6 : ℝ)) * (Real.sin r)) + ((-(6 : ℝ)) * p₁ * (Real.cos r)))

/-- coefficient of u³ in L p̃f (= −1/2 by sin² + cos² = 1) -/
noncomputable def c3 (r : ℝ) : ℝ := (((-((1 : ℝ) / (2 : ℝ))) * ((Real.cos r) ^ 2)) + ((-((1 : ℝ) / (2 : ℝ))) * ((Real.sin r) ^ 2)))

/-- coefficient of u^4 in L p̃f -/
noncomputable def c4 (r p₁ : ℝ) : ℝ := (((-(6 : ℝ)) * (Real.sin r)) + ((Real.cos r) * (Real.sin r)) + ((-(1 : ℝ)) * (p₁ ^ 4) * (Real.sin r)) + ((-(9 : ℝ)) * p₁ * (Real.cos r)) + ((-(6 : ℝ)) * ((Real.cos r) ^ 2) * (Real.sin r)) + ((6 : ℝ) * (p₁ ^ 3) * (Real.cos r)) + ((7 : ℝ) * (p₁ ^ 2) * (Real.sin r)) + ((-((19 : ℝ) / (2 : ℝ))) * p₁ * ((Real.sin r) ^ 2)) + (((7 : ℝ) / (2 : ℝ)) * p₁ * ((Real.cos r) ^ 2)) + ((-(12 : ℝ)) * (p₁ ^ 2) * (Real.cos r) * (Real.sin r)))

/-- |c4| ≤ this (triangle inequality, |sin|,|cos| ≤ 1) -/
noncomputable def c4_bound (p₁ : ℝ) : ℝ := (13 : ℝ) * |p₁| ^ 0 + (22 : ℝ) * |p₁| ^ 1 + (19 : ℝ) * |p₁| ^ 2 + (6 : ℝ) * |p₁| ^ 3 + (1 : ℝ) * |p₁| ^ 4

/-- coefficient of u^5 in L p̃f -/
noncomputable def c5 (r p₁ : ℝ) : ℝ := (((8 : ℝ) * ((Real.sin r) ^ 2)) + ((-(12 : ℝ)) * (p₁ ^ 2) * ((Real.sin r) ^ 2)) + ((-(2 : ℝ)) * ((Real.sin r) ^ 2) * (Real.cos r)) + ((-(12 : ℝ)) * p₁ * ((Real.cos r) ^ 2) * (Real.sin r)) + ((-(4 : ℝ)) * (p₁ ^ 3) * (Real.cos r) * (Real.sin r)) + ((4 : ℝ) * p₁ * (Real.cos r) * (Real.sin r)))

/-- |c5| ≤ this (triangle inequality, |sin|,|cos| ≤ 1) -/
noncomputable def c5_bound (p₁ : ℝ) : ℝ := (10 : ℝ) * |p₁| ^ 0 + (16 : ℝ) * |p₁| ^ 1 + (12 : ℝ) * |p₁| ^ 2 + (4 : ℝ) * |p₁| ^ 3

end RotorFl
